# ── Claude (Claude Agent SDK) ─────────────────────────────────────────
# Por defecto se usa la sesión de Claude Code de esta máquina (`claude` → /login).
# Opcional: si defines una API key, el SDK la usa en lugar de la sesión.
ANTHROPIC_API_KEY=
# Modelo para guiones (vacío = el modelo por defecto de Claude Code). Ej.: claude-opus-5
CLAUDE_MODEL=
# Modelo para el agente explorador del ERP (Fase 3). Por defecto = CLAUDE_MODEL.
CLAUDE_EXPLORER_MODEL=

# ── ERP demo (Fase 3) ─────────────────────────────────────────────────
# Solo entorno DEMO. El agente no puede salir del dominio de ERP_URL.
ERP_URL=
ERP_USER=
ERP_PASSWORD=
# Empresa a seleccionar al iniciar sesión.
ERP_COMPANY=
# Debe ser "demo" para permitir la exploración/grabación.
ERP_ENV=demo
# Cliente (nombre o RUC) que el agente debe usar en los tutoriales.
ERP_SAMPLE_CUSTOMER=
# Hosts de producción que nunca se deben tocar (separados por coma).
ERP_PROD_HOSTS=

# Navegador para explorar/grabar (opcional). Ruta a Chrome si Playwright no descargó el suyo.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
# Solo detrás de un proxy corporativo que re-cifra TLS: certificado de su CA.
BROWSER_EXTRA_CA_FILE=

# ── Voz (Fase 2) ──────────────────────────────────────────────────────
# elevenlabs | kokoro (local, gratis: npm run setup:kokoro) | silent (prueba)
TTS_PROVIDER=elevenlabs
KOKORO_VOICE=em_alex
KOKORO_SPEED=1.0
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── Render ────────────────────────────────────────────────────────────
JOBS_DIR=./jobs
# Opcional: ruta a Chrome Headless Shell si no quieres que Remotion lo descargue.
REMOTION_BROWSER_EXECUTABLE=
