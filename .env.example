# ── Claude ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Modelo para guiones (storyboard). Configurable.
CLAUDE_MODEL=claude-opus-5
# Modelo para el agente explorador del ERP (Fase 3). Por defecto = CLAUDE_MODEL.
CLAUDE_EXPLORER_MODEL=
# Reintento automático en el servidor si el modelo rechaza la petición ("default" | "off").
CLAUDE_FALLBACKS=default

# ── ERP demo (Fase 3) ─────────────────────────────────────────────────
# Solo entorno DEMO. El agente no puede salir del dominio de ERP_URL.
ERP_URL=
ERP_USER=
ERP_PASSWORD=
# Debe ser "demo" para permitir la exploración/grabación.
ERP_ENV=demo
# Hosts de producción que nunca se deben tocar (separados por coma).
ERP_PROD_HOSTS=

# ── Voz (Fase 2) ──────────────────────────────────────────────────────
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── Render ────────────────────────────────────────────────────────────
JOBS_DIR=./jobs
# Opcional: ruta a Chrome Headless Shell si no quieres que Remotion lo descargue.
REMOTION_BROWSER_EXECUTABLE=
